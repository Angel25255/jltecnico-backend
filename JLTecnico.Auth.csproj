<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de datos (PostgreSQL / Supabase) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Autenticación JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />

    <!-- Hash de contraseñas -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- TOTP (doble factor) -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />

    <!-- Generación de código QR -->
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- Envío de correos (alertas de dispositivo nuevo) -->
    <PackageReference Include="MailKit" Version="4.8.0" />

    <!-- Generación de PDF (boletas de venta y reportes) -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />

    <!-- Generación de Excel (reportes exportables) -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />

    <!-- Swagger para probar los endpoints -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
